{
  "version": 2,
  "installCommand": "npm install && npm install --prefix backend",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js?path=$1" },
    { "src": "/api", "dest": "/api/index.js" },
    { "src": "^/owner/?$", "dest": "/public/owner.html" },
    { "src": "^/owner\\.html$", "dest": "/public/owner.html" },
    { "src": "/([^\\.]+)", "dest": "/public/$1.html" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
