NODE_ENV=development
HOST=127.0.0.1
PORT=5050
MAX_PORT_HOPS=20
MONGODB_URI=mongodb://127.0.0.1:27017/lift_edtech
MONGO_RETRY_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SUPER_ADMIN_INSTITUTION_ID=LIFT-HQ-0000
SUPER_ADMIN_USERNAME=owner
SUPER_ADMIN_PASSWORD=ChangeMeNow123!

# File storage (set provider to inline, s3, or cloudinary)
STORAGE_PROVIDER=inline
UPLOAD_MAX_MB=12
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Onboarding automations webhook (works with n8n/webhook relay)
AUTOMATION_ENABLED=true
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
AUTOMATION_TIMEOUT_MS=10000
